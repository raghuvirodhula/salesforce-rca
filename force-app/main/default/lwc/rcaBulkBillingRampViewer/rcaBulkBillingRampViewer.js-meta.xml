<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>BB1 Bulk Billing — Ramp Viewer</masterLabel>
    <description>Displays the ramp-pricing schedule for a BB1 bulk billing contract: discount % per year, net annual price, and total contract value.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage">
            <property name="productCode"      type="String"  label="Product Code"     default="BB1"/>
            <property name="termYears"        type="Integer" label="Term (Years)"     default="3"/>
            <property name="baseAnnualPrice"  type="Integer" label="Base Annual Price" default="0"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
